#!/usr/bin/env bash
# ============================================================
# kb —— 知识库每日使用启动器（Linux / macOS）
#   Windows 用户用同目录的 kb.cmd（双击，或 PowerShell 里 kb xxx）。
#
# 作用：把 pipeline/ 下各工具封装成语义命令，默认以本脚本所在目录为 vault
# （经 KB_ROOT 传入），所以你不用记得 --root。需要操作其它库时用 `--root <路径>`
# 覆盖，或用环境变量 KB_ROOT。
#
# 插件化版本：所有命令统一通过 kb_launcher.py 路由到插件注册中心。
#
# 用法: kb <工具> [参数...]
#   kb rag index                 # 重建本地向量索引（写新笔记后必跑）
#   kb query "怎么备份知识库"      # 自然语言检索
#   kb ingest                    # 收件箱摄入 triage 清单
#   kb ingest move               # 按路由把收件箱挪到对应分区（写操作）
#   kb ingest agent              # 摄取本机 agent 记忆进 KB
#   kb feedback                  # 命中信号计数
#   kb link                      # 孤岛补链建议
#   kb link apply                # 应用补链（写操作）
#   kb recall                    # 今日回忆 deck
#   kb healthcheck               # 健康巡检报告
#   kb dashboard                 # 生成治理仪表盘
#   kb clean --apply             # 清洗/分块（写操作）
#   kb validate                  # frontmatter 校验
#   kb sync dry-run              # 知识同步管道
#   kb backup [daily|weekly]     # 全量快照 -> backups/
#   kb list                      # 列出所有插件
#   kb help                      # 本说明
# ============================================================
set -euo pipefail

# 解析脚本自身的真实目录（跟随符号链接）。
# 全局 kb 是 ~/.local/bin/kb → <vault>/kb 的软链；若直接用 dirname "$0"，
# 会得到链接所在目录（~/.local/bin），把 VAULT 解析错导致命令全废。
SOURCE="${BASH_SOURCE[0]}"
while [ -L "$SOURCE" ]; do
  LINK_DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ "$SOURCE" != /* ]] && SOURCE="$LINK_DIR/$SOURCE"
done
SELF_DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
VAULT="$SELF_DIR"

PY=""
if command -v python3 >/dev/null 2>&1; then PY=python3
elif command -v python >/dev/null 2>&1; then PY=python
elif command -v py >/dev/null 2>&1; then PY=py
fi
if [ -z "$PY" ]; then
  echo "❌ 未找到 Python，请先安装 Python 3.8+ 并加进 PATH。" >&2; exit 3
fi

# 所有命令（含 backup）统一走 kb_launcher.py（插件注册中心动态路由）。
# backup 现由 pipeline/backup.py 跨平台实现，Windows 亦可用。
#
# 目标库优先级：命令行 --root > 环境变量 KB_ROOT > 本脚本所在目录。
# 这里只设 KB_ROOT 默认值（不追加 --root），用户显式 --root 才能覆盖。
export KB_ROOT="${KB_ROOT:-$VAULT}"
exec "$PY" "$VAULT/pipeline/kb_launcher.py" "$@"
