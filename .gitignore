# ================================
# kb-kit 仓库忽略项（保持推送干净）
# ================================

# 作者 dev-repo 运行时记忆（私人路径 + 会话记录；运行时在 install 目录 .agents/，不进分发）
.agents/

# 可重新生成分发包（不必入库）
kb-kit-*.zip

# 内部开发体检报告（不进公开仓库）
DEPLOYMENT_REPORT.md

# Python 产物
__pycache__/
*.pyc
.pytest_cache/

# 若本地建仓留下的样例 vault
KB/
KB2/
KB3/

# 极端情况下建仓产物误放仓库根（保险）
/**/.git/
/**/vector\ index/
/**/backups/
/**/logs/

# 操作系统产物
.DS_Store
Thumbs.db

# 运行时知识库状态（审计日志、状态文件、向量索引；不进公开仓库）
/**/.kb/

# 虚拟环境
.venv/
venv/
env/

# CodeGraph 本地索引（工具产物，不进仓库）
.codegraph/

# 本地安装测试环境（安装验证用，不进仓库）
ceshi/

# 架构图产物（本地生成，不进仓库）
arch/
